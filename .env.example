# ===========================================
# MOVIE HUB BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this to .env and update with your values

# ---- DATABASE ----
# SQLite (default - local file, never shuts down)
DATABASE_URL=sqlite:///./moviehub.db

# PostgreSQL (for production on Railway/Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- JWT AUTHENTICATION ----
# Secret key for JWT tokens (IMPORTANT: Change in production!)
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Token expiration time in hours
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- API KEY AUTH (Optional - for /extract endpoint) ----
# Set to "true" to require API key for extraction endpoints
AUTH_ENABLED=false

# Your secret API key (required if AUTH_ENABLED=true)
# Generate a secure key: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# ---- CORS SETTINGS ----
# Comma-separated list of allowed frontend URLs, or * for all
# For production, specify your frontend URL(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# ---- WORKER SETTINGS ----
# Number of concurrent extraction threads
MAX_WORKERS=3

# Maximum number of download links to process per request
MAX_LIMIT=50

# ---- SELENIUM TIMEOUTS (seconds) ----
# Initial page load wait time
PAGE_LOAD_WAIT=4

# Wait time for Cloudflare bypass
CLOUDFLARE_WAIT=10

# Extra wait time if still stuck on Cloudflare
CLOUDFLARE_EXTRA_WAIT=15

# Wait time after clicking buttons
BUTTON_CLICK_WAIT=4
